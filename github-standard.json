{
  "_comment": "Declarative GitHub repo-config baseline. Consumed by github-standard.py — see that file's header and docs/github-standard.md for the full rationale. Every override below carries a comment naming why; don't 'fix' a pinned exception back to the default without reading the linked doc first.",

  "org": "guidodinello",

  "defaults": {
    "settings": {
      "delete_branch_on_merge": true,
      "allow_auto_merge": true,
      "allow_squash_merge": true,
      "allow_merge_commit": false,
      "allow_rebase_merge": false
    },
    "security": {
      "vulnerability_alerts": true,
      "automated_security_fixes": true,
      "secret_scanning": "public-only"
    },
    "ruleset": {
      "target": "branch",
      "enforcement": "active",
      "bypass_actors": [],
      "rules": [
        { "type": "deletion" },
        { "type": "non_fast_forward" },
        {
          "type": "copilot_code_review",
          "parameters": { "review_on_push": false, "review_draft_pull_requests": false }
        },
        { "type": "required_signatures" },
        {
          "type": "pull_request",
          "parameters": {
            "required_approving_review_count": 0,
            "dismiss_stale_reviews_on_push": false,
            "required_reviewers": [],
            "require_code_owner_review": false,
            "require_last_push_approval": false,
            "required_review_thread_resolution": true,
            "allowed_merge_methods": ["squash"]
          }
        },
        { "type": "code_quality", "parameters": { "severity": "errors" } }
      ]
    }
  },

  "_profiles_comment": "A profile describes the shape of a branch's review posture — not the repo's settings (those stay a repo-level settings_overrides, since GitHub settings aren't branch-scoped even when the policy driving them is). A repo/branch resolves to a profile explicitly ('profile': '<name>') or defaults to 'baseline'. Profile fields layer on top of defaults.ruleset the same way repo/branch overrides do: rule_overrides deep-merge into the matching default rule, extra_rules append, bypass_actors replace wholesale if set.",

  "profiles": {
    "hobby": {
      "_comment": "Scratch/personal repos pushed to directly. No ruleset at all — just the settings+security baseline.",
      "tier": "settings"
    },

    "baseline": {
      "_comment": "The canonical shape: squash-only, 0 required approvals, required signatures, zero bypass. Used as-is by most repos; also the implicit default for any branch that doesn't name a profile.",
      "tier": "ruleset"
    },

    "oss": {
      "_comment": "Published, publicly-contributable projects (CODEOWNERS committed) — needs real review of external contributions, which baseline's 0-approval posture doesn't provide. Reference: pullscope.",
      "tier": "ruleset",
      "bypass_actors": [
        { "actor_id": 2, "actor_type": "RepositoryRole", "bypass_mode": "always" },
        { "actor_id": 5, "actor_type": "RepositoryRole", "bypass_mode": "always" }
      ],
      "rule_overrides": {
        "pull_request": {
          "required_approving_review_count": 1,
          "require_code_owner_review": true,
          "dismiss_stale_reviews_on_push": true
        }
      }
    },

    "flagship": {
      "_comment": "Multi-stage release branches on a repo with a real deploy pipeline — a release promotion is a merge commit, never squash, because squash breaks ancestry between two long-lived branches (fitted incident: releases #391/#394, see ADR-027). Apply only to the release/main branch of a two-stage flow, not to the integration branch feeding it — that one stays 'baseline' (squash). Reference: fitted/main.",
      "tier": "ruleset",
      "rule_overrides": {
        "pull_request": { "allowed_merge_methods": ["merge"] }
      },
      "extra_rules": [
        { "type": "required_deployments", "parameters": { "required_deployment_environments": [] } }
      ]
    }
  },

  "repos": {
    "rl-tournament-notification-bot": { "profile": "baseline" },
    "claude-dotfiles":                { "profile": "baseline" },
    "logger":                         { "profile": "baseline" },
    "claude-client":                  { "profile": "baseline" },
    "claude-web-backup":              { "profile": "baseline" },
    "weekly-highlights":              { "profile": "baseline" },
    "pencast":                        { "profile": "baseline" },
    "shell-utils":                    { "profile": "baseline" },
    "knowledger-token-updater":       { "profile": "baseline" },

    "dotfiles":            { "profile": "hobby" },
    "anki":                { "profile": "hobby" },
    "ig":                  { "profile": "hobby" },
    "metodos-montecarlo":  { "profile": "hobby" },
    "skipper":             { "profile": "hobby" },
    "deployer":            { "profile": "hobby" },

    "knowledger-bot": {
      "profile": "baseline",
      "branches": {
        "main": {
          "extra_rules": [
            {
              "type": "required_status_checks",
              "parameters": {
                "strict_required_status_checks_policy": false,
                "do_not_enforce_on_create": false,
                "required_status_checks": [{ "context": "CI" }]
              }
            }
          ]
        }
      }
    },

    "smart-clippy": {
      "profile": "baseline",
      "branches": {
        "main": {
          "extra_rules": [
            {
              "type": "required_status_checks",
              "parameters": {
                "strict_required_status_checks_policy": false,
                "do_not_enforce_on_create": false,
                "required_status_checks": [
                  { "context": "Lint & Format Check" },
                  { "context": "Build Extension" }
                ]
              }
            }
          ]
        }
      }
    },

    "scripts": {
      "profile": "baseline",
      "branches": {
        "main": {
          "extra_rules": [
            {
              "type": "required_status_checks",
              "parameters": {
                "strict_required_status_checks_policy": false,
                "do_not_enforce_on_create": false,
                "required_status_checks": [{ "context": "quality" }]
              }
            }
          ]
        }
      }
    },

    "url-shortener": {
      "profile": "baseline",
      "branches": {
        "main": {
          "extra_rules": [
            {
              "type": "required_status_checks",
              "parameters": {
                "strict_required_status_checks_policy": false,
                "do_not_enforce_on_create": false,
                "required_status_checks": [
                  { "context": "lint" },
                  { "context": "svelte" }
                ]
              }
            }
          ]
        }
      }
    },

    "fitted": {
      "_comment": "development uses 'baseline' (squash, feature integration); main uses 'flagship' (merge-commit release promotion, per ADR-027). allow_merge_commit stays enabled repo-wide per the same ADR (L80-81) — the flagship profile can't set this itself since it's a repo setting, not branch-scoped.",
      "settings_overrides": { "allow_merge_commit": true },
      "branches": {
        "development": {
          "profile": "baseline",
          "extra_rules": [
            { "type": "required_deployments", "parameters": { "required_deployment_environments": [] } },
            {
              "type": "required_status_checks",
              "parameters": {
                "strict_required_status_checks_policy": false,
                "do_not_enforce_on_create": false,
                "required_status_checks": [
                  { "context": "Typecheck Python" },
                  { "context": "Unit Tests (Python)" },
                  { "context": "Integration Tests (Python)" },
                  { "context": "Security Scan (Python)" },
                  { "context": "Lint Frontend" },
                  { "context": "Typecheck Frontend" },
                  { "context": "Tests (Frontend)" },
                  { "context": "Lint Python" }
                ]
              }
            }
          ]
        },
        "main": {
          "profile": "flagship",
          "extra_rules": [
            {
              "type": "required_status_checks",
              "parameters": {
                "strict_required_status_checks_policy": false,
                "do_not_enforce_on_create": false,
                "required_status_checks": [
                  { "context": "Typecheck Python" },
                  { "context": "Unit Tests (Python)" },
                  { "context": "Integration Tests (Python)" },
                  { "context": "Security Scan (Python)" },
                  { "context": "Lint Frontend" },
                  { "context": "Typecheck Frontend" },
                  { "context": "Tests (Frontend)" },
                  { "context": "Lint Python" }
                ]
              }
            }
          ]
        }
      }
    },

    "pullscope": {
      "_comment": "review_on_push:true and required_linear_history predate this baseline and weren't identified as drift during the audit — kept as repo-level additions on top of the 'oss' profile rather than folded into the profile itself, since they're not necessarily true of every OSS repo.",
      "branches": {
        "main": {
          "profile": "oss",
          "rule_overrides": {
            "copilot_code_review": { "review_on_push": true }
          },
          "extra_rules": [
            { "type": "required_linear_history" },
            {
              "type": "required_status_checks",
              "parameters": {
                "strict_required_status_checks_policy": false,
                "do_not_enforce_on_create": true,
                "required_status_checks": [
                  { "context": "Lint & Format Check", "integration_id": 15368 },
                  { "context": "Build Extension (chrome)", "integration_id": 15368 },
                  { "context": "Build Extension (firefox)", "integration_id": 15368 }
                ]
              }
            }
          ]
        }
      }
    }
  }
}
