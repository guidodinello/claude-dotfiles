{
  "permissions": {
    "allow": [
      "Read(./**)",
      "Bash(op read:*)",
      "Bash(security find-generic-password:*)",
      "Bash(rtk:*)",
      "Bash(python3 -I {{CONFIG_DIR}}/skills/remind/scripts/remind.py:*)",
      "mcp__plugin_engram_engram__mem_context",
      "mcp__engram__mem_context",
      "mcp__engram__mem_save",
      "mcp__engram__mem_update",
      "mcp__engram__mem_session_summary",
      "mcp__engram__mem_save_prompt",
      "mcp__engram__mem_capture_passive",
      "mcp__engram__mem_search",
      "mcp__engram__mem_get_observation",
      "mcp__engram__mem_judge",
      "mcp__engram__mem_compare"
    ],
    "deny": [
      "Read(.env*)",
      "Edit(.env*)",
      "Read(//**/.env)",
      "Read(//**/*.env)",
      "Read(//**/.env.local)",
      "Read(//**/.env.*.local)",
      "Read(//**/.env.development)",
      "Read(//**/.env.production)",
      "Read(//**/.env.staging)",
      "Read(//**/.env.test)",
      "Edit(//**/.env)",
      "Edit(//**/*.env)",
      "Edit(//**/.env.local)",
      "Edit(//**/.env.*.local)",
      "Edit(//**/.env.development)",
      "Edit(//**/.env.production)",
      "Edit(//**/.env.staging)",
      "Edit(//**/.env.test)",
      "Bash(*>> *.env)",
      "Bash(*> *.env)",
      "Bash(*>> *.env.local)",
      "Bash(*> *.env.local)",
      "Bash(*>> *.env.development)",
      "Bash(*> *.env.development)",
      "Bash(*>> *.env.production)",
      "Bash(*> *.env.production)",
      "Bash(*>> *.env.staging)",
      "Bash(*> *.env.staging)",
      "Bash(*>> *.env.test)",
      "Bash(*> *.env.test)",
      "Bash(*>> *.env.*.local)",
      "Bash(*> *.env.*.local)",
      "Read(!.env.example)",
      "Read(!.env.*.example)",
      "Read(!.env.sample)",
      "Read(!.env.template)",
      "Edit(!.env.example)",
      "Edit(!.env.*.example)",
      "Edit(!.env.sample)",
      "Edit(!.env.template)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus",
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "skillOverrides": {
    "audit-consolidation-validator": "off",
    "audit-fact-checker": "off",
    "db-migration-planner": "off",
    "markdown-to-slite": "off",
    "meta-skill-db-scalability-audit-improver": "off",
    "meta-skill-hipaa-audit-improver": "off",
    "meta-skill-security-audit-improver": "off",
    "slite-compare-docs": "off",
    "ticket-refinement": "off",
    "clean-permissions": "user-invocable-only",
    "code-health": "user-invocable-only",
    "db-scalability-audit": "user-invocable-only",
    "hipaa-audit": "user-invocable-only",
    "improve-codebase-architecture": "user-invocable-only",
    "permissions-audit": "user-invocable-only",
    "security-audit": "user-invocable-only",
    "conventional-commits": "off",
    "git-brag": "off",
    "qa-check": "off",
    "writing-react-effects": "off",
    "accessibility-review": "user-invocable-only",
    "api-gap-audit": "user-invocable-only",
    "async-audit": "user-invocable-only",
    "discover-conventions": "user-invocable-only",
    "fix-ignores": "user-invocable-only",
    "react-composition-audit": "user-invocable-only",
    "scripts-audit": "user-invocable-only",
    "type-health": "user-invocable-only",
    "ui-ux-review": "user-invocable-only",
    "anthropic-skills:google-workspace": "off",
    "anthropic-skills:import-memory": "off",
    "anthropic-skills:internal-comms": "off",
    "anthropic-skills:morning": "off",
    "anthropic-skills:project-knowledge-update": "off",
    "agents-sdk": "off",
    "cloudflare": "off",
    "cloudflare-email-service": "off",
    "cloudflare-one": "off",
    "cloudflare-one-migrations": "off",
    "durable-objects": "off",
    "sandbox-sdk": "off",
    "turnstile-spin": "off",
    "workers-best-practices": "off",
    "wrangler": "off",
    "go-testing": "off",
    "ios-sim": "off",
    "opencode-dual-review": "user-invocable-only",
    "find-skills": "user-invocable-only",
    "gentle-ai-bench": "user-invocable-only",
    "issue-creation": "user-invocable-only",
    "skill-improver": "user-invocable-only"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "{{CONFIG_DIR}}/hooks/guard-bash.sh"
          }
        ]
      },
      {
        "matcher": "Read|Edit|Write|NotebookEdit|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "{{CONFIG_DIR}}/hooks/guard-env-files.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "{{CONFIG_DIR}}/hooks/json-lint.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I {{CONFIG_DIR}}/hooks/dev-docs-index-check.py"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I {{CONFIG_DIR}}/hooks/reminders.py"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I {{CONFIG_DIR}}/hooks/reminders.py"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "{{CONFIG_DIR}}/statusline.sh",
    "refreshInterval": 30
  },
  "extraKnownMarketplaces": {
    "engram": {
      "source": {
        "source": "github",
        "repo": "Gentleman-Programming/engram"
      }
    }
  },
  "effortLevel": "medium",
  "advisorModel": "opus",
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true
}
