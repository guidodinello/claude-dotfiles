{
  "permissions": {
    "allow": [
      "Read(./**)",
      "Bash(op read:*)",
      "Bash(security find-generic-password:*)",
      "Bash(rtk:*)",
      "mcp__plugin_engram_engram__mem_context",
      "Edit(//home/guido/.local/state/herdr-routines/reports/**)"
    ],
    "deny": [
      "Read(.env*)",
      "Edit(**/.env)",
      "Bash(*>> *.env)",
      "Bash(*> *.env)",
      "Bash(echo * > *.env*)",
      "Bash(echo * >> *.env*)"
    ],
    "defaultMode": "auto",
    "additionalDirectories": [
      "/home/guido/.local/state/herdr-routines/reports"
    ]
  },
  "model": "opusplan",
  "skillOverrides": {
    "audit-consolidation-validator": "off",
    "audit-fact-checker": "off",
    "clickup-create-ticket": "off",
    "db-migration-planner": "off",
    "figma-to-tailwind": "off",
    "markdown-to-clickup-doc": "off",
    "markdown-to-slite": "off",
    "meta-skill-db-scalability-audit-improver": "off",
    "meta-skill-hipaa-audit-improver": "off",
    "meta-skill-security-audit-improver": "off",
    "slite-compare-docs": "off",
    "slite-to-clickup": "off",
    "ticket-refinement": "off",
    "clean-permissions": "user-invocable-only",
    "code-health": "user-invocable-only",
    "code-review-claude-no-autopost": "user-invocable-only",
    "db-scalability-audit": "user-invocable-only",
    "hipaa-audit": "user-invocable-only",
    "improve-codebase-architecture": "user-invocable-only",
    "opencode-code-review": "user-invocable-only",
    "permissions-audit": "user-invocable-only",
    "security-audit": "user-invocable-only",
    "clickup-task-description": "off",
    "conventional-commits": "off",
    "git-brag": "off",
    "qa-check": "off",
    "writing-react-effects": "off"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          },
          {
            "type": "command",
            "command": "cmd=$(cat | jq -r '.command // \"\"'); if echo \"$cmd\" | grep -qP 'docker\\s+(compose|stack)\\s+.*\\bdown\\b.*(-v|--volumes)\\b|docker\\s+volume\\s+(rm|remove|prune)\\b'; then echo \"BLOCKED: destructive Docker volume command. Volumes hold persistent data and removal is irreversible. Ask the user before running this.\"; exit 2; fi"
          },
          {
            "type": "command",
            "command": "cmd=$(cat | jq -r '.command // \"\"'); if [ -n \"$CLOUDFLARE_ENV\" ] && echo \"$cmd\" | grep -qP 'wrangler(\\s+|$)'; then echo \"BLOCKED: CLOUDFLARE_ENV=$CLOUDFLARE_ENV is set — wrangler may silently target that environment. Unset it and use explicit --env flags instead.\"; exit 2; fi; if echo \"$cmd\" | grep -qP 'wrangler(\\s+|$)(?=.*d1\\s+(?:execute|migrations\\s+apply))(?!.*--local)'; then echo \"BLOCKED: wrangler d1 execute/migrations apply without --local targets production. Run the command manually with --remote after reviewing.\"; exit 2; fi"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "if [[ $CLAUDE_FILE_PATH == *.json ]]; then jq . \"$CLAUDE_FILE_PATH\" > /dev/null || echo \"Warning: $CLAUDE_FILE_PATH is not valid JSON\"; fi"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/home/guido/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh",
    "refreshInterval": 30
  },
  "enabledPlugins": {
    "skill-creator@claude-plugins-official": false,
    "code-simplifier@claude-plugins-official": false,
    "engram@engram": true,
    "claude-code-setup@claude-plugins-official": false,
    "security-guidance@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": false,
    "code-review@claude-plugins-official": false,
    "pyright-lsp@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "engram": {
      "source": {
        "source": "github",
        "repo": "Gentleman-Programming/engram"
      }
    }
  },
  "effortLevel": "medium",
  "advisorModel": "opus",
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "skipAutoPermissionPrompt": true,
  "agentPushNotifEnabled": true
}
